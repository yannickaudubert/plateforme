# Core
# Leave unset to use values from config/app.json.
APP_NAME=Cockpit OS DSI Transverse
APP_ENV=development
# Safe local default. Network exposure requires an explicit reviewed override.
APP_HOST=127.0.0.1
APP_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Paths
# Keep machine-specific paths out of Git; override locally in .env.
OBSIDIAN_VAULT_PATH=./data/obsidian-vault
OBSIDIAN_ALLOWED_ROOTS=./data/obsidian-vault
OBSIDIAN_HOST_PATH=./data/obsidian-vault
COCKPIT_CONFIG_FILE=./config/app.json
COCKPIT_LOG_DIR=./logs

# Tool endpoints
NOCODB_BASE_URL=http://localhost:8080
NOCODB_WRITABLE_TABLES=
N8N_BASE_URL=http://localhost:5678
PERPLEXICA_BASE_URL=http://localhost:3001
OPENWEBUI_BASE_URL=http://localhost:3000

# Secrets (set real values in .env; never commit them)
NOCODB_API_TOKEN=
N8N_API_KEY=
PERPLEXICA_API_KEY=
OPENWEBUI_API_KEY=

# Full stack compose
# Generate strong values locally before enabling the full stack.
NOCODB_JWT_SECRET=
OPENWEBUI_SECRET_KEY=
GENERIC_TIMEZONE=Europe/Paris
# Supply-chain follow-up: replace moving tags with reviewed immutable versions/digests.
PERPLEXICA_IMAGE=itsthedev/perplexica:latest
