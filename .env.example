# Core
# Leave unset to use values from config/app.json.
APP_NAME=Cockpit OS DSI Transverse
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Paths
OBSIDIAN_VAULT_PATH=D:/Yannick
OBSIDIAN_ALLOWED_ROOTS=D:/Yannick
OBSIDIAN_HOST_PATH=./data/obsidian-vault
COCKPIT_CONFIG_FILE=./config/app.json
COCKPIT_LOG_DIR=./logs

# Tool endpoints
NOCODB_BASE_URL=http://localhost:8080
NOCODB_WRITABLE_TABLES=
N8N_BASE_URL=http://localhost:5678
PERPLEXICA_BASE_URL=http://localhost:3001
OPENWEBUI_BASE_URL=http://localhost:3000

# Secrets (set real values in .env)
NOCODB_API_TOKEN=
N8N_API_KEY=
PERPLEXICA_API_KEY=
OPENWEBUI_API_KEY=

# Full stack compose
NOCODB_JWT_SECRET=change-me
OPENWEBUI_SECRET_KEY=change-me
GENERIC_TIMEZONE=Europe/Paris
PERPLEXICA_IMAGE=itsthedev/perplexica:latest
